<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white flex flex-col items-center justify-center gap-4 p-10">
        <h3 class="text-3xl font-bold">Login</h3>
        <form action="/login" method="POST">
        <input class="px-3 py-2 rounded-md outline-none bg-transparent border-2 border-zinc-800" type="email" required name="email" placeholder="Email">
        <input class="px-3 py-2 rounded-md outline-none bg-transparent border-2 border-zinc-800" type="password" required name="password" placeholder="Password">
        <button class="px-5 py-2 rounded-md bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 border border-blue-500 hover:border-transparent" type="submit">Login</button>
        </form>
    </div>
</body>
</html>