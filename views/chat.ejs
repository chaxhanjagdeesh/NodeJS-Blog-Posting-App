<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Chat</title>

    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body class="bg-zinc-950 text-white h-screen flex flex-col">
    <div class="border-b border-zinc-800 bg-zinc-900 px-6 py-4 flex items-center gap-4">
        <a href="/messages"
            class="px-4 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 transition">
            Back
        </a>
        <img src="/images/<%= receiver.profilePic %>"
            class="w-12 h-12 rounded-full object-cover border border-zinc-700">
        <div>
            <h1 class="text-lg font-bold">
                <%= receiver.name || receiver.username %>
            </h1>
            <p class="text-sm text-zinc-400">
                @<%= receiver.username %>
            </p>
        </div>
    </div>

    <div id="messages"
        class="flex-1 overflow-y-auto p-6 space-y-4">
        <% messages.forEach(message => { %>
            <% if(message.sender._id.toString() === currentUser.userid) { %>
                <div class="flex justify-end">
                    <div
                        class="bg-blue-600 px-5 py-3 rounded-2xl rounded-br-md max-w-[70%]">
                        <p class="text-sm">
                            <%= message.text %>
                        </p>
                    </div>
                </div>
            <% } else { %>
                <div class="flex justify-start">
                    <div
                        class="bg-zinc-800 border border-zinc-700 px-5 py-3 rounded-2xl rounded-bl-md max-w-[70%]">
                        <p class="text-sm">
                            <%= message.text %>
                        </p>
                    </div>
                </div>
            <% } %>
        <% }) %>
    </div>

    <div class="border-t border-zinc-800 bg-zinc-900 p-5">
        <div class="flex gap-3">
            <input
                type="text"
                id="messageInput"
                placeholder="Type a message..."
                class="flex-1 bg-zinc-800 border border-zinc-700 rounded-xl px-5 py-4 outline-none focus:border-blue-500">
            <button
                id="sendBtn"
                class="px-6 py-4 rounded-xl bg-blue-600 hover:bg-blue-700 transition font-semibold">
                Send
            </button>
        </div>
    </div>
    <script>
        const socket = io();
        const sender = "<%= currentUser.userid %>";
        const receiver = "<%= receiver._id %>";
        const roomId = [sender, receiver]
            .sort()
            .join("_");

        socket.emit("join-room", roomId);
        const sendBtn = document.getElementById("sendBtn");
        const input = document.getElementById("messageInput");
        const messages = document.getElementById("messages");

        sendBtn.addEventListener("click", () => {
            const text = input.value.trim();
            if (!text) return;
            socket.emit("send-message", {
                sender,
                receiver,
                text
            });
            input.value = "";
        });

        socket.on("receive-message", (message) => {
            const isMine = message.sender === sender;
            messages.innerHTML += `
                <div class="flex ${isMine ? "justify-end" : "justify-start"}">
                    <div class="${isMine
                        ? "bg-blue-600"
                        : "bg-zinc-800 border border-zinc-700"
                    } px-5 py-3 rounded-2xl max-w-[70%]">
                        <p class="text-sm">
                            ${message.text}
                        </p>
                    </div>
                </div>
            `;

            messages.scrollTop = messages.scrollHeight;

        });

    </script>

</body>

</html>
