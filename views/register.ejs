<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-zinc-950 via-zinc-900 to-black min-h-screen text-white">

    <!-- Navbar -->
    <nav class="w-full border-b border-zinc-800 bg-zinc-900/70 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

            <h1
                class="text-2xl font-extrabold bg-gradient-to-r from-blue-500 to-cyan-400 bg-clip-text text-transparent">
                Blog Posting
            </h1>

            <a href="/auth/login"
                class="px-5 py-2 rounded-xl bg-zinc-800 hover:bg-blue-600 transition font-semibold border border-zinc-700">
                Login
            </a>

        </div>
    </nav>

    <!-- Main -->
    <div class="w-full min-h-[90vh] flex items-center justify-center px-5 py-10">

        <!-- Register Card -->
        <div
            class="w-full max-w-2xl bg-zinc-900/70 backdrop-blur-md border border-zinc-800 rounded-3xl p-8 shadow-2xl shadow-black/40">

            <!-- Heading -->
            <div class="text-center mb-8">
                <h2 class="text-4xl font-extrabold mb-2">
                    Create Account
                </h2>

                <p class="text-zinc-400">
                    Join Blog Posting and start sharing your thoughts.
                </p>
            </div>

            <!-- Form -->
            <form action="/auth/register" method="POST" enctype="multipart/form-data"
                class="grid grid-cols-1 md:grid-cols-2 gap-5">

                <!-- Email -->
                <div class="md:col-span-2">
                    <label class="block mb-2 text-sm text-zinc-400">
                        Email Address
                    </label>

                    <input type="email" required name="email" placeholder="Enter your email"
                        class="w-full px-4 py-3 rounded-xl bg-zinc-800 border border-zinc-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 transition">
                </div>

                <!-- Password -->
                <div>
                    <label class="block mb-2 text-sm text-zinc-400">
                        Password
                    </label>

                    <input type="password" required name="password" placeholder="Create password"
                        class="w-full px-4 py-3 rounded-xl bg-zinc-800 border border-zinc-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 transition">
                </div>

                <!-- Username -->
                <div>
                    <label class="block mb-2 text-sm text-zinc-400">
                        Username
                    </label>

                    <input type="text" required name="username" placeholder="@username"
                        class="w-full px-4 py-3 rounded-xl bg-zinc-800 border border-zinc-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 transition">
                </div>

                <!-- Full Name -->
                <div>
                    <label class="block mb-2 text-sm text-zinc-400">
                        Full Name
                    </label>

                    <input type="text" required name="name" placeholder="Your full name"
                        class="w-full px-4 py-3 rounded-xl bg-zinc-800 border border-zinc-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 transition">
                </div>

                <!-- Age -->
                <div>
                    <label class="block mb-2 text-sm text-zinc-400">
                        Age
                    </label>

                    <input type="number" required name="age" placeholder="Your age"
                        class="w-full px-4 py-3 rounded-xl bg-zinc-800 border border-zinc-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 transition">
                </div>

                <!-- Profile Picture -->
                <div class="md:col-span-2">
                    <label class="block mb-2 text-sm text-zinc-400">
                        Profile Picture
                    </label>

                    <div
                        class="w-full border-2 border-dashed border-zinc-700 rounded-2xl p-6 bg-zinc-800/50 hover:border-blue-500 transition">

                        <input type="file" required name="profilePic"
                            class="w-full text-sm text-zinc-300
                            file:mr-4 file:py-2 file:px-4
                            file:rounded-lg file:border-0
                            file:text-sm file:font-semibold
                            file:bg-blue-500 file:text-white
                            hover:file:bg-blue-600 cursor-pointer">

                    </div>
                </div>

                <!-- Submit -->
                <div class="md:col-span-2 mt-2">
                    <button type="submit"
                        class="w-full py-3 rounded-xl bg-gradient-to-r from-blue-500 to-cyan-500 hover:scale-[1.01] hover:shadow-lg hover:shadow-blue-500/30 transition duration-300 font-bold text-lg">
                        Create Account
                    </button>
                </div>

            </form>

            <!-- Bottom -->
            <p class="text-center text-zinc-400 mt-6">
                Already have an account?
                <a href="/auth/login" class="text-blue-400 hover:text-blue-300 font-semibold">
                    Login
                </a>
            </p>

        </div>

    </div>

</body>

</html>