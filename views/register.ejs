<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white flex flex-col items-center justify-center gap-4 p-10">
        <h3 class="text-3xl font-bold">Create Account</h3>
        <h5 class="text-md font-bold">Or <a href="/auth/login" class="text-blue-500 hover:text-blue-400">Login</a></h5>
        <form action="/auth/register" method="POST">
            <input class="px-3 py-2 rounded-md outline-none bg-transparent border-2 border-zinc-800" type="email"
                required name="email" placeholder="Email">
            <input class="px-3 py-2 rounded-md outline-none bg-transparent border-2 border-zinc-800" type="password"
                required name="password" placeholder="Password">
            <input class="px-3 py-2 rounded-md outline-none bg-transparent border-2 border-zinc-800" type="text"
                required name="username" placeholder="Username">
            <input class="px-3 py-2 rounded-md outline-none bg-transparent border-2 border-zinc-800" type="text"
                required name="name" placeholder="Name">
            <input class="px-3 py-2 rounded-md outline-none bg-transparent border-2 border-zinc-800" type="number"
                required name="age" placeholder="Age">
            <button
                class="px-5 py-2 rounded-md bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 border border-blue-500 hover:border-transparent"
                type="submit">Create Account</button>
        </form>
    </div>
</body>

</html>