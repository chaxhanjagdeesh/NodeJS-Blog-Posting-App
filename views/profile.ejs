<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-zinc-950 via-zinc-900 to-black text-white min-h-screen">

    <!-- Navbar -->
    <nav class="w-full border-b border-zinc-800 bg-zinc-900/70 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

            <!-- Logo -->
             <a href="/">
            <h1
                class="text-2xl font-extrabold bg-gradient-to-r from-blue-500 to-cyan-400 bg-clip-text text-transparent">
                Blog Posting
            </h1>
        </a>

            <!-- Right -->
            <div class="flex items-center gap-4">

                <!-- User -->
                <div class="flex items-center gap-3 bg-zinc-800 px-4 py-2 rounded-2xl">

                    <div class="w-11 h-11 rounded-full overflow-hidden border-2 border-zinc-700 shadow-md">
                        <img src="../images/<%= user.profilePic %>" alt="profile" class="w-full h-full object-cover">
                    </div>

                    <div>
                        <p class="text-xs text-zinc-400">
                            Logged in as
                        </p>

                        <h3 class="font-semibold">
                            <%= user.name %>
                        </h3>
                    </div>

                </div>

                <!-- Logout -->
                <button
                    class="px-5 py-2 rounded-xl bg-red-500 hover:bg-red-600 transition font-semibold shadow-lg shadow-red-500/20"
                    onclick="window.location.href='/auth/logout'">
                    Logout
                </button>

            </div>

        </div>
    </nav>

    <!-- Main -->
    <main class="max-w-6xl mx-auto px-5 py-10 grid grid-cols-1 lg:grid-cols-3 gap-10">

        <!-- Left Section -->
        <div class="lg:col-span-1">

            <!-- User Card -->
            <div class="bg-zinc-900/70 border border-zinc-800 rounded-3xl p-8 shadow-2xl shadow-black/30">

                <div class="flex flex-col items-center text-center">

                    <!-- Profile -->
                    <div
                        class="w-28 h-28 rounded-full overflow-hidden border-4 border-blue-500 shadow-lg shadow-blue-500/20 mb-5">

                        <img src="../images/<%= user.profilePic %>" alt="profile" class="w-full h-full object-cover">

                    </div>

                    <h2 class="text-3xl font-bold">
                        <%= user.name %>
                    </h2>

                    <p class="text-blue-400 mt-1">
                        @<%= user.username %>
                    </p>

                    <div class="flex gap-6 mt-6">

                        <div class="text-center">
                            <h3 class="text-2xl font-bold">
                                <%= user.posts.length %>
                            </h3>
                            <p class="text-zinc-400 text-sm">
                                Posts
                            </p>
                        </div>

                    </div>

                </div>

            </div>

            <!-- Create Post -->
            <div class="bg-zinc-900/70 border border-zinc-800 rounded-3xl p-6 mt-8 shadow-xl shadow-black/20">

                <h3 class="text-2xl font-bold mb-2">
                    Create Post
                </h3>

                <p class="text-zinc-400 mb-5">
                    Share your thoughts with everyone.
                </p>

                <form action="/dashboard/post" method="POST" class="flex flex-col gap-4" enctype="multipart/form-data">
                    <input type="file" required name="postImg" class="w-full text-sm text-zinc-300
                            file:mr-4 file:py-2 file:px-4
                            file:rounded-lg file:border-0
                            file:text-sm file:font-semibold
                            file:bg-blue-500 file:text-white
                            hover:file:bg-blue-600 cursor-pointer">

                    <textarea name="content" required placeholder="What's on your mind?"
                        class="w-full h-36 p-4 resize-none rounded-2xl bg-zinc-800 border border-zinc-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30 transition"></textarea>

                    <button type="submit"
                        class="w-full py-3 rounded-2xl bg-gradient-to-r from-blue-500 to-cyan-500 hover:scale-[1.01] hover:shadow-lg hover:shadow-blue-500/30 transition duration-300 font-bold text-lg">
                        Post Now
                    </button>

                </form>

            </div>

        </div>

        <!-- Posts -->
        <div class="lg:col-span-2">

            <div class="flex items-center justify-between mb-6">

                <div>
                    <h2 class="text-4xl font-bold">
                        Your Posts
                    </h2>

                    <p class="text-zinc-400 mt-1">
                        Manage and interact with your posts.
                    </p>
                </div>

            </div>

            <div class="space-y-6">

                <% user.posts.reverse().forEach(post=> { %>

                 <div
    class="bg-zinc-900/70 border border-zinc-800 rounded-3xl overflow-hidden hover:border-blue-500/40 hover:shadow-xl hover:shadow-blue-500/10 transition duration-300">

    <!-- Post Image -->
    <% if(post.postImg) { %>
        <div class="w-full h-[100px] overflow-hidden border-b border-zinc-800">
            <img src="../images/<%= post.postImg %>" alt="post-image"
                class="w-full h-full object-cover hover:scale-105 transition duration-500">
        </div>
    <% } %>

    <!-- Content Wrapper -->
    <div class="p-6">

        <!-- Top -->
        <div class="flex items-center gap-4 mb-5">

            <div class="w-14 h-14 rounded-full overflow-hidden border-2 border-zinc-700">
                <img src="../images/<%= user.profilePic %>" alt="profile"
                    class="w-full h-full object-cover">
            </div>

            <div>
                <h3 class="text-lg font-semibold">
                    <%= user.name %>
                </h3>

                <p class="text-blue-400 text-sm">
                    @<%= user.username %>
                </p>
            </div>

        </div>

        <!-- Content -->
        <p class="text-zinc-200 leading-relaxed tracking-wide text-[15px]">
            <%= post.content %>
        </p>

        <!-- Footer -->
        <div
            class="flex flex-wrap items-center justify-between gap-4 mt-6 border-t border-zinc-800 pt-5">

            <!-- Likes -->
            <div class="flex items-center gap-3">

                <span class="px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 text-sm">
                    ❤️ <%= post.likes.length %> Likes
                </span>

            </div>

            <!-- Actions -->
            <div class="flex items-center gap-5 text-sm font-medium">

                <a href="/dashboard/like/<%= post._id %>"
                    class="text-blue-400 hover:text-blue-300 transition">

                    <%= post.likes.includes(user._id) ? "Unlike" : "Like" %>

                </a>

                <a href="/dashboard/delete/<%= post._id %>"
                    class="text-zinc-400 hover:text-red-400 transition">
                    Delete
                </a>

            </div>

        </div>

    </div>

</div>

                    <% }); %>

            </div>

        </div>

    </main>

</body>

</html>