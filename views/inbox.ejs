<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inbox</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-zinc-950 text-white min-h-screen">
    <div class="border-b border-zinc-800 bg-zinc-900 px-6 py-4 flex items-center justify-between">
        <h1 class="text-2xl font-bold">
            Inbox
        </h1>
        <a href="/"
            class="px-4 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 transition">
            Back
        </a>
    </div>

    <div class="max-w-2xl mx-auto p-6 space-y-4">
        <% if(users.length === 0) { %>
            <div class="text-center text-zinc-500 mt-20">
                No conversations yet.
            </div>
        <% } %>
        <% users.forEach(user => { %>
            <a href="/messages/<%= user._id %>"
                class="flex items-center gap-4 bg-zinc-900 border border-zinc-800 hover:border-blue-500 transition rounded-2xl p-4">
                <img src="/images/<%= user.profilePic %>"
                    class="w-14 h-14 rounded-full object-cover border border-zinc-700">
                <div>
                    <h2 class="font-semibold text-lg">
                        <%= user.name || user.username %>
                    </h2>
                    <p class="text-zinc-400 text-sm">
                        @<%= user.username %>
                    </p>
                </div>
            </a>
        <% }) %>
    </div>
</body>
</html>