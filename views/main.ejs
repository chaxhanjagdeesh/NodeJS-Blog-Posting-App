<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>
    <div class="bg-zinc-800 flex gap-5 justify-end p-5">
        <h3 class="text-3xl text-white font-bold">All Blogs</h3>
      <a href="/auth/login"><button
                class="px-5 py-2 rounded-md bg-zinc-500 hover:bg-blue-600 text-white font-bold py-2 px-4 border border-blue-500 hover:border-transparent">Login</button></a>
        <a href="/auth/register"><button
                class="px-5 py-2 rounded-md bg-zinc-500 hover:bg-green-600 text-white font-bold py-2 px-4 border border-green-500 hover:border-transparent">Register</button></a>
    </div>
    <div class="w-full min-h-screen bg-zinc-900 text-white flex flex-col items-center justify-center gap-4 p-10">
       
        <div class="posts max-w-lg min-w-min">
            <div class="postcontainer">

                <% posts.forEach(post=> { %>
                    <div class="post mb-4 p-5 border-2 border-zinc-800 rounded-md mt-5">
                        <h4 class="text-blue-500 mb-2">@<%= post.user.username %>
                        </h4>
                        <p class="text-sm tracking-tight">
                            <%= post.content %>
                        </p>
                        
                    </div>
                    <% }); %>
                    <div class="flex gap-5 mt-5">
                    <button class="px-5 py-2 rounded-md bg-zinc-500 hover:bg-blue-600 text-white font-bold" onclick="window.location.href='/?page=<%= parseInt(page) - 1 %>'" <%= page <= 1 ? 'disabled' : '' %>>
                        Previous
                    </button>
                    <button class="px-5 py-2 rounded-md bg-zinc-500 hover:bg-blue-600 text-white  font-bold" onclick="window.location.href='/?page=<%= parseInt(page) + 1 %>'" <%= posts.length < limit ? 'disabled' : '' %>>
                        Next
                    </button>   
                </div>
            </div>
        </div>

      
    </div>
</body>

</html>