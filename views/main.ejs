<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Blogs</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-zinc-950 via-zinc-900 to-black text-white min-h-screen">

    <!-- Navbar -->
    <% if (user) { %>
        <nav class="w-full border-b border-zinc-800 bg-zinc-900/80 backdrop-blur-md sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

                <!-- Logo -->
                <h1
                    class="text-2xl font-extrabold bg-gradient-to-r from-blue-500 to-cyan-400 bg-clip-text text-transparent">
                    Blog Posting
                </h1>

                <!-- User -->
                <div class="flex items-center gap-4">

                    <a href="/dashboard/profile"
                        class="flex items-center gap-3 hover:bg-zinc-800 px-3 py-2 rounded-xl transition duration-300">

                        <img src="../images/1780557799781-5ce6ba55959f.jpeg" alt="profile"
                            class="w-11 h-11 rounded-full object-cover border-2 border-zinc-700 shadow-md">

                        <div>
                            <p class="text-xs text-zinc-400">Welcome back</p>
                            <h2 class="font-semibold text-lg">
                                <%= user.name %>
                            </h2>
                        </div>
                    </a>

                    <select onchange="window.location.href=this.value"
                        class="bg-zinc-800 border border-zinc-700 px-4 py-2 rounded-xl outline-none hover:border-blue-500 transition">
                        <option selected disabled>Go To</option>
                        <option value="/dashboard/profile">Create Post</option>
                        <option value="/auth/logout">Logout</option>
                    </select>

                </div>
            </div>
        </nav>

        <% } else { %>

            <nav class="w-full border-b border-zinc-800 bg-zinc-900/80 backdrop-blur-md">
                <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

                    <h1
                        class="text-2xl font-extrabold bg-gradient-to-r from-blue-500 to-cyan-400 bg-clip-text text-transparent">
                        BlogSphere
                    </h1>

                    <div class="flex items-center gap-4">
                        <a href="/auth/login">
                            <button
                                class="px-5 py-2 rounded-xl bg-zinc-800 hover:bg-blue-600 transition font-semibold border border-zinc-700">
                                Login
                            </button>
                        </a>

                        <a href="/auth/register">
                            <button
                                class="px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 transition font-semibold shadow-lg shadow-blue-500/20">
                                Register
                            </button>
                        </a>
                    </div>
                </div>
            </nav>

            <% } %>

                <!-- Main -->
                <main class="max-w-3xl mx-auto px-5 py-10">

                    <!-- Top -->
                    <div class="flex items-center justify-between mb-8">

                        <div>
                            <h2 class="text-4xl font-bold">Latest Posts</h2>
                            <p class="text-zinc-400 mt-1">
                                Read what people are sharing today.
                            </p>
                        </div>

                        <!-- Sort -->
                        <select onchange="window.location.href='/?sort=' + this.value"
                            class="p-3 bg-zinc-900 border border-zinc-700 rounded-xl outline-none hover:border-blue-500 transition">
                            <option value="newest">Newest</option>
                            <option value="oldest">Oldest</option>
                        </select>
                    </div>

                    <!-- Posts -->
                    <div class="space-y-6">

                        <% posts.forEach(post=> { %>



                            <div
                                class="bg-zinc-900/70 border border-zinc-800 rounded-2xl overflow-hidden hover:border-blue-500/40 hover:shadow-xl hover:shadow-blue-500/10 transition duration-300">

                                <!-- Post Image -->
                                <% if(post.postImg) { %>
                                    <div class="w-full h-[200px] overflow-hidden border-b border-zinc-800">
                                        <img src="../images/<%= post.postImg %>" alt="post-image"
                                            class="w-full h-full object-cover hover:scale-105 transition duration-500">
                                    </div>
                                    <% } %>

                                        <!-- Content Wrapper -->
                                        <div class="p-6">

                                            <!-- User -->
                                            <div class="flex items-center gap-4 mb-5">

                                                <div
                                                    class="w-14 h-14 rounded-full overflow-hidden border-2 border-zinc-700 shadow-md">
                                                    <img src="../images/<%= post.user.profilePic %>" alt="profile"
                                                        class="w-full h-full object-cover">
                                                </div>

                                                <div>
                                                    <h3 class="text-lg font-semibold">
                                                        <%= post.user.name || post.user.username %>
                                                    </h3>

                                                    <p class="text-blue-400 text-sm">
                                                        @<%= post.user.username %>
                                                    </p>
                                                </div>

                                            </div>

                                            <!-- Content -->
                                            <p class="text-zinc-200 leading-relaxed tracking-wide text-[15px]">
                                                <%= post.content %>
                                            </p>

                                            <!-- Footer -->
                                            <div
                                                class="flex flex-wrap items-center justify-between gap-4 mt-6 border-t border-zinc-800 pt-5">

                                                <!-- Date -->
                                                <span class="text-zinc-500 text-sm">
                                                    <%= new Date(post.date).toDateString() %>
                                                </span>

                                                <!-- Actions -->
                                                <div class="flex items-center gap-3">

                                                    <!-- Likes -->
                                                    <span
                                                        class="px-3 py-1 rounded-full bg-zinc-800 text-zinc-300 text-sm">
                                                        ❤️ <%= post.likes.length %>
                                                    </span>

                                                    <% if (user) { %>
                                                        <!-- Like Button -->
                                                        <a href="/dashboard/likemain/<%= post._id %>"
                                                            class="px-4 py-2 rounded-lg bg-zinc-800 hover:bg-blue-600 transition text-white text-sm font-medium">

                                                            <%= post.likes.includes(user?._id) ? "Unlike" : "Like" %>

                                                        </a>

                                                        <% } %>
                                                        <!-- Comment Button -->
                                                        <button onclick="toggleComments('<%= post._id %>')"
                                                            class="px-4 py-2 rounded-lg bg-zinc-800 hover:bg-cyan-600 transition text-white text-sm font-medium">
                                                            Comments
                                                        </button>
                                                </div>

                                            </div>

                                            <!-- Comment Section -->
                                            <div id="comments-<%= post._id %>"
                                                class="hidden mt-5 border-t border-zinc-800 pt-5">

                                                <!-- Comment Input -->
                                                    <% if (user) { %>

                                                <div class="flex gap-3 mb-5">
                                                    <form action="/dashboard/comment/<%= post._id %>" method="POST"
                                                        class="flex items-center gap-3 w-full">
                                                        <input type="text" placeholder="Write a comment..."
                                                            class="flex-1 bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 outline-none focus:border-cyan-500 text-sm"
                                                            name="content">

                                                        <button type="submit"
                                                            class="px-5 py-3 rounded-xl bg-cyan-600 hover:bg-cyan-700 transition text-sm font-semibold">
                                                            Post
                                                        </button>
                                                    </form>

                                                </div>
                                                        <% } %>

                                                <!-- Dummy Comments -->
                                                <div class="space-y-4">

                                                    <% post.comments.forEach(element=> { %>

                                                        <% if(element.user) { %>

                                                            <div class="bg-zinc-800/70 rounded-xl p-4">

                                                                <div class="flex items-center gap-3 mb-2">

                                                                    <img src="../images/<%= element.user.profilePic %>"
                                                                        class="w-10 h-10 rounded-full object-cover">

                                                                    <div>
                                                                        <h4 class="font-semibold text-sm">
                                                                            <%= element.user.name %>
                                                                        </h4>

                                                                        <p class="text-zinc-400 text-xs">
                                                                            @<%= element.user.username %>
                                                                        </p>
                                                                    </div>

                                                                </div>

                                                                <p class="text-sm text-zinc-200">
                                                                    <%= element.content %>
                                                                </p>

                                                            </div>

                                                            <% } %>

                                                                <% }); %>



                                                </div>

                                            </div>

                                        </div>

                            </div>

                            <% }); %>

                    </div>

                    <!-- Pagination -->
                    <div class="flex justify-center gap-5 mt-10">

                        <button
                            class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-blue-600 transition font-semibold disabled:opacity-40 disabled:cursor-not-allowed"
                            onclick="window.location.href='/?page=<%= parseInt(page) - 1 %>'" <%=page <=1 ? 'disabled'
                            : '' %>>
                            Previous
                        </button>

                        <button
                            class="px-6 py-3 rounded-xl bg-zinc-800 hover:bg-blue-600 transition font-semibold disabled:opacity-40 disabled:cursor-not-allowed"
                            onclick="window.location.href='/?page=<%= parseInt(page) + 1 %>'" <%=posts.length < limit
                            ? 'disabled' : '' %>>
                            Next
                        </button>

                    </div>

                </main>

                <script>
                    function toggleComments(id) {
                        const section = document.getElementById(`comments-${id}`);
                        section.classList.toggle("hidden");
                    }
                </script>

</body>

</html>